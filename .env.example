
# ============================================
# CONFIGURACION DEL BACKEND
# ============================================

PORT=4000
NODE_ENV=development

# ============================================
# BASE DE DATOS POSTGRESQL
# ============================================

# Usar una base de datos de prueba.
# Reemplazar estos valores solo en el archivo .env local.
# Nunca publicar contrasenas reales.

DATABASE_URL=postgresql://USUARIO_LOCAL:CAMBIAR_PASSWORD@localhost:5432/acuapp_dev

# Variables utilizadas por scripts auxiliares
DB_USER=USUARIO_LOCAL
DB_HOST=localhost
DB_NAME=acuapp_dev
DB_PASSWORD=CAMBIAR_PASSWORD
DB_PORT=5432

# ============================================
# FRONTEND
# ============================================

VITE_API_URL=http://localhost:4000/api
