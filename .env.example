# =====================================================
# CONFIGURACIÓN DEL SERVIDOR BACKEND (EXPRESS)
# =====================================================
PORT=4000
NODE_ENV=development

# =====================================================
# CONEXIÓN A LA BASE DE DATOS POSTGRESQL
# =====================================================
# Opción 1: Instancia remota serverless en Neon Cloud (Recomendada con SSL)
DATABASE_URL="postgresql://neondb_owner:tu_password@ep-ejemplo.us-east-2.aws.neon.tech/neondb?sslmode=verify-full"

# Opción 2: Instancia local de PostgreSQL
# DATABASE_URL="postgresql://postgres:1234@localhost:5433/acuaapp_db"

# Parámetros desglosados (utilizados por scripts de mantenimiento)
DB_USER=postgres
DB_HOST=localhost
DB_NAME=acuaapp_db
DB_PASSWORD=1234
DB_PORT=5433

# =====================================================
# CONFIGURACIÓN DEL FRONTEND (VITE)
# =====================================================
VITE_API_URL="http://localhost:4000/api"
