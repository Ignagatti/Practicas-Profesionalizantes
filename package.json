{
  "name": "practicas-profesionalizantes",
  "version": "1.0.0",
  "description": "Sistema de Gestión Administrativa - Fábrica de Sillas y Sillones",
  "main": "src/electron/main.js",
  "scripts": {
    "backend": "nodemon src/backend/server.js",
    "frontend": "vite src/frontend",
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "build:vite": "vite build src/frontend",
    "build:exe": "powershell -Command \"Remove-Item -Recurse -Force dist-electron -ErrorAction SilentlyContinue\" && npm run build:vite && electron-builder --win",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "build": {
    "appId": "com.tuempresa.acuaber",
    "productName": "Acuaber",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "src/backend/**/*",
      "src/electron/**/*",
      "assets/**/*",
      "package.json",
      ".env"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/logo-acuaber.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Acuaber-Instalador.exe"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ignagatti/Practicas-Profesionalizantes.git"
  },
  "author": "Acuaber",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Ignagatti/Practicas-Profesionalizantes/issues"
  },
  "homepage": "https://github.com/Ignagatti/Practicas-Profesionalizantes#readme",
  "dependencies": {
    "@neon/config": "^1.1.0",
    "@neon/env": "^1.1.6",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "^1.20.0",
    "multer": "^2.2.0",
    "pg": "^8.21.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.0",
    "electron": "^41.3.0",
    "electron-builder": "^26.15.3",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.14"
  }
}
